# Shared Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Web Environment (Next.js)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# API Environment (FastAPI)
DATABASE_URL="postgresql://user:password@localhost:5432/aurum"
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-..."

# Vercel Blob
BLOB_READ_WRITE_TOKEN="..."

# Vantage / MetaApi (Broker Integration)
META_API_TOKEN="your-metaapi-auth-token"
META_API_ACCOUNT_ID="your-metaapi-account-id"

# Production scout cron (set the real values in Vercel, not in git)
# AURUM_AGENTS_ENABLED=true lets /api/cron/scout run. false is the kill switch.
AURUM_AGENTS_ENABLED=true
# Leave this at 0 so scout stages Ready for Approval ideas. Declan signs them
# on /app/approvals (that writes an ApprovalEvent) and then clicks Execute.
# The flag never places a broker order.
AURUM_AUTO_APPROVE=0
SCOUT_SYMBOLS=BTC-EUR,SOL-EUR,SHIB-EUR,AVAX-EUR,ENA-EUR,DOGE-EUR,SUI-EUR,XRP-EUR
SCOUT_PLAYBOOK=trend_follower
# When set, Vercel sends Authorization: Bearer <CRON_SECRET> on cron invocations
# and /api/cron/scout rejects other callers. Generate the value in the Vercel
# dashboard. Leave this blank in the repo.
CRON_SECRET=
