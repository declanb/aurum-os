# Shared Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Web Environment (Next.js)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# API Environment (FastAPI)
# postgresql:// and postgresql+psycopg:// both use the psycopg v3 driver
# (psycopg[binary] in requirements.txt). SQLAlchemy 2.1 selects that dialect
# for a bare postgresql:// URL. postgresql+psycopg2:// uses psycopg2-binary.
DATABASE_URL="postgresql://user:password@localhost:5432/aurum"
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-..."

# Vercel Blob
BLOB_READ_WRITE_TOKEN="..."

# Vantage / MetaApi (Broker Integration)
META_API_TOKEN="your-metaapi-auth-token"
META_API_ACCOUNT_ID="your-metaapi-account-id"

# Paper copy book. Virtual EUR balance only. Never places a Revolut X order.
# Revolut X has no native copy API. See docs/helm-copy-book.md.
# HELM_COPY_BANKROLL_EUR=200
# AURUM_COPY_BANKROLL_EUR=200
# HELM_COPY_POSITION_PCT=0.10
# HELM_COPY_MAX_NOTIONAL_EUR=40

# trend_scout — read-only SignalBundles, default off. See docs/HELM_AGENT_FLEET.md.
# Does not place a Revolut X order.
# AURUM_TREND_SCOUT=0
# AURUM_TREND_SCOUT_NETWORK=0

# Public regime context for the advisor (read-only). Off by default.
# When 1, scout / recommendations / the OpenAI Agents advisor attach
# CoinGecko global, Fear & Greed, and CoinDesk headlines to the prompt.
# Separate from trend_scout. Still ends at a TradeIdea.
# AURUM_TREND_CONTEXT=0
# X_TREND_QUERY=(bitcoin OR ethereum OR solana) lang:en -is:retweet

# Optional. Read-only X API v2 bearer for recent public search (GET only).
# Leave empty to skip X. Do not use a token that can post. Never commit a real token.
# X_BEARER_TOKEN=

# Revolut X HTTP API (required on Vercel — the revx CLI is not in the function image).
# Leave these empty locally to keep using `revx` plus ~/.config/revolut-x/.
# When both the API key and a private key are set, REVX_TRANSPORT=auto uses HTTPS.
# REVX_API_KEY is the key from Revolut X → Profile → API keys.
# REVX_PRIVATE_KEY is the Ed25519 PKCS#8 PEM from `openssl genpkey -algorithm ed25519`.
# In a single-line env value, put literal \n between PEM lines.
# REVX_PRIVATE_KEY_B64 is an alternative: base64 of that PEM, of the PKCS#8 DER,
# or of the raw 32-byte seed. REVOLUT_X_API_KEY is an alias of REVX_API_KEY.
# Placeholders only. Never commit a real key.
REVX_API_KEY=""
REVX_PRIVATE_KEY=""
REVX_PRIVATE_KEY_B64=""
REVX_API_BASE_URL="https://revx.revolut.com"
REVX_TRANSPORT="auto"
